<resources>
    <style name="Base.Theme.DirtyFrag" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorOnPrimary">@color/on_primary</item>
        <item name="colorSecondary">@color/secondary</item>
        <item name="colorOnSecondary">@color/on_primary</item>
        <item name="colorSurface">@color/card_background</item>
        <item name="colorOnSurface">@color/ink</item>
        <item name="android:colorAccent">@color/primary</item>
        <item name="android:statusBarColor">@color/page_background</item>
        <item name="android:navigationBarColor">@color/page_background</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowBackground">@color/page_background</item>
    </style>
    <style name="Theme.DirtyFrag" parent="Base.Theme.DirtyFrag" />
    <style name="Widget.DirtyFrag.BottomNavigation.ActiveIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@color/nav_active_indicator</item>
    </style>
</resources>
